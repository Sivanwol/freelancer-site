# Site URL - Update this with your actual domain
NEXT_PUBLIC_SITE_URL=https://www.devco-solution.online

# Google Analytics 4 Measurement ID (optional - leave empty to disable)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Tag Manager container ID (optional - defaults to GTM-MN4LJ534)
NEXT_PUBLIC_GTM_ID=GTM-MN4LJ534

# Attio CRM API token (server-only — required for contact form submissions)
ATTIO_API_KEY=

# Soro blog embed token (server-only). Optional override for the public embed id in lib/soro.ts.
# List:  GET https://app.trysoro.com/api/embed/${SORO_EMBED_TOKEN}
# Body:  GET https://app.trysoro.com/api/embed/${SORO_EMBED_TOKEN}/article/${id}
# The embed script assigns SORO_ARTICLES. Do not expose this id in client bundles.
# Leave unset to use the public id; production builds must succeed without this variable.
SORO_EMBED_TOKEN=cba1e92c-70c0-4f06-9f93-6fc454e7a2d0
